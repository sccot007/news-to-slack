# 실제 값은 .env 파일에 넣고 커밋하지 않는다.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# 요약/번역용 LLM. Gemini를 우선 호출하고 실패 시 Anthropic으로 폴백한다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 사이트별로 확인할 최신 글 개수 (기본 10)
ITEMS_PER_SITE=10

# 중복 판단 키워드 유사도 임계값 (기본 0.6)
DEDUP_KEYWORD_THRESHOLD=0.6

# 발송 이력 보관 기간(일) (기본 30). ARTICLES_RETENTION_DAYS와 같은 값으로 맞춰둔다.
HISTORY_RETENTION_DAYS=30

# full_translate 사이트(예: CNCF Blog)의 번역 전문 페이지가 배포되는 GitHub Pages 기본 URL
PAGES_BASE_URL=https://sccot007.github.io/news-to-slack

# 번역 전문 페이지(docs/articles/*.html) 보관 기간(일). 이보다 오래된 페이지는 자동 삭제된다 (기본 30)
ARTICLES_RETENTION_DAYS=30
